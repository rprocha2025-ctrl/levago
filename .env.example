# Copie para ".env" e preencha. NUNCA suba o .env real para o GitHub.

# Porta do servidor (local). Em produção o host define automaticamente.
PORT=3000

# Segredo para assinar os tokens de login (troque por algo longo e aleatório)
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Chave do Google Maps usada no NAVEGADOR (restrita por domínio/HTTP referrer)
GOOGLE_MAPS_API_KEY=

# (Opcional) Chave do Google usada no SERVIDOR para calcular a rota/distância
# (restrita por IP). Se vazio, usa a GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_KEY=

# Caminho do banco SQLite (padrão: ./leva.db)
# DB_PATH=./leva.db

# Em produção:
# NODE_ENV=production
